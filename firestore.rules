rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================ Helpers ============================
    function isSignedIn() {
      return request.auth != null;
    }

    // Signed in and not globally banned. A missing profile doc is treated as not banned.
    function isNotBanned() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true
      );
    }

    function isCommunityMember(communityId) {
      return isNotBanned() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        communityId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.joinedCommunities;
    }

    function isCommunityOwner(communityId) {
      return isCommunityMember(communityId) &&
        exists(/databases/$(database)/documents/communities/$(communityId)) &&
        get(/databases/$(database)/documents/communities/$(communityId)).data.adminUid == request.auth.uid;
    }

    function hasCommunityPermission(communityId, permission) {
      return isCommunityMember(communityId) &&
        exists(/databases/$(database)/documents/communities/$(communityId)) && (
        isCommunityOwner(communityId) ||
        (
          get(/databases/$(database)/documents/communities/$(communityId)).data.memberPermissions != null &&
          get(/databases/$(database)/documents/communities/$(communityId)).data.memberPermissions[request.auth.uid] != null &&
          get(/databases/$(database)/documents/communities/$(communityId)).data.memberPermissions[request.auth.uid][permission] == true
        )
      );
    }

    // ------------------------ parental controls ------------------------
    // A guardian is linked through parentalLinks/{parentUid}, which can only
    // be created with a code the child's own account generated. The child has
    // at most one guardian, so every helper below is a single lookup.
    function guardianChildUid() {
      return get(/databases/$(database)/documents/parentalLinks/$(request.auth.uid)).data.childUid;
    }

    function isGuardianOfMemberOf(communityId) {
      return isNotBanned() &&
        exists(/databases/$(database)/documents/parentalLinks/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/users/$(guardianChildUid())) &&
        communityId in get(/databases/$(database)/documents/users/$(guardianChildUid())).data.get('joinedCommunities', []);
    }

    function hasParentalControls() {
      return exists(/databases/$(database)/documents/parentalControls/$(request.auth.uid));
    }

    function parentalControlsFor(uid) {
      return get(/databases/$(database)/documents/parentalControls/$(uid)).data;
    }

    function isCommunityCreationBlockedForMe() {
      return hasParentalControls() &&
        parentalControlsFor(request.auth.uid).get('blockCommunityCreation', false) == true;
    }

    // Roles assigned to a member, normalised to a list: legacy documents store
    // a single role id string instead of an array.
    function memberRoleIds(community, uid) {
      let assigned = community.memberRoles != null ? community.memberRoles[uid] : null;
      return assigned == null ? [] : (assigned is list ? assigned : [assigned]);
    }

    // Members holding one of an invite-only voice room's inviter roles may add
    // guests to that room's invitedUids map without full channel management.
    function canInviteToVoiceChannel(channel) {
      return channel.type == 'voice' &&
        channel.joinMode == 'invite' &&
        channel.inviteRoles is list &&
        exists(/databases/$(database)/documents/communities/$(channel.communityId)) &&
        memberRoleIds(get(/databases/$(database)/documents/communities/$(channel.communityId)).data, request.auth.uid).hasAny(channel.inviteRoles);
    }

    // ============================== users ==============================
    // NOTE: reads are granted to every signed-in non-banned user because the
    // member list, global user search, and profiles all read from this
    // collection. Emails are therefore visible to other signed-in users - move
    // them to users/{userId}/private if that is a concern.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isNotBanned());
      allow create: if isNotBanned() && request.auth.uid == userId &&
        request.resource.data.isBanned == false &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 40 &&
        request.resource.data.joinedCommunities is list &&
        request.resource.data.joinedCommunities.size() == 0;
      // Users may only update their own profile. isBanned can never be set from
      // the client. Optional profile fields may be absent on legacy profiles;
      // reading .size() on a missing key throws and denies the whole write, so
      // use Map.get() defaults instead of direct property access.
      allow update: if isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBanned']) &&
        request.resource.data.get('displayName', '').size() <= 40 &&
        request.resource.data.get('aboutMe', '').size() <= 1000 &&
        request.resource.data.get('status', '').size() <= 40 &&
        request.resource.data.get('avatarBase64', '').size() <= 3000000 &&
        // Joining a community a guardian blocked is denied here as well as in
        // the UI, so the block cannot be bypassed by a modified client.
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['joinedCommunities']) ||
          !hasParentalControls() ||
          !request.resource.data.joinedCommunities.removeAll(resource.data.get('joinedCommunities', [])).hasAny(parentalControlsFor(userId).get('blockedCommunities', []))
        );
      allow delete: if false;

      // Per-channel read receipts used by unread dots, "mark all as read", and
      // the unread-count tab badge. Always scoped to the owner's subcollection.
      match /lastRead/{channelId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ============================ communities ============================
    match /communities/{communityId} {
      // A guardian may read the child's communities (even private ones).
      allow read: if isGuardianOfMemberOf(communityId) ||
        resource.data.isPrivate == false || isNotBanned();
      allow create: if isNotBanned() &&
        !isCommunityCreationBlockedForMe() &&
        request.resource.data.adminUid == request.auth.uid &&
        request.resource.data.name is string && request.resource.data.name.size() <= 60 &&
        request.resource.data.description is string && request.resource.data.description.size() <= 300 &&
        request.resource.data.iconBase64.size() <= 3000000;
      allow update: if isCommunityOwner(communityId) ||
        (
          hasCommunityPermission(communityId, 'manage_community') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'iconBase64', 'theme', 'systemMessages', 'autoMod'])
        ) ||
        (
          hasCommunityPermission(communityId, 'manage_invites') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteCode'])
        ) ||
        (
          hasCommunityPermission(communityId, 'manage_roles') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'memberRoles', 'memberPermissions'])
        ) ||
        (
          hasCommunityPermission(communityId, 'manage_members') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bannedUsers', 'timedOutUsers', 'kickedUsers'])
        );
      // NOTE: kicks/bans also remove the member from users/{uid}.joinedCommunities.
      // That write must come from a server-side function (Admin SDK), not the
      // client, since a rule cannot prove which community the requester moderates.
      allow delete: if isCommunityOwner(communityId);
    }

    // ============================== channels ==============================
    match /channels/{channelId} {
      allow read: if isCommunityMember(resource.data.communityId) ||
        isGuardianOfMemberOf(resource.data.communityId);
      allow create: if hasCommunityPermission(request.resource.data.communityId, 'manage_channels') &&
        request.resource.data.name is string && request.resource.data.name.size() <= 60 &&
        (request.resource.data.type == 'text' || request.resource.data.type == 'voice');
      allow update: if hasCommunityPermission(resource.data.communityId, 'manage_channels') ||
        (
          isCommunityMember(resource.data.communityId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedUids']) &&
          canInviteToVoiceChannel(resource.data)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivity'])
        );
      allow delete: if hasCommunityPermission(resource.data.communityId, 'manage_channels');
    }

    // ============================= friends =============================
    // One document per pair of friends, id = sorted uids joined by '_'. There is
    // no dual write to each user's profile, because rules only let a user edit
    // their own document. Either member may remove the friendship.
    match /friendships/{pairId} {
      allow read: if isSignedIn();
      allow create, update: if isNotBanned() &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.memberUids.size() == 2;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.memberUids;
    }

    // Friend requests: id = '<from>_<to>'. Only the sender creates one, only the
    // recipient answers it, and either side may withdraw it.
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isNotBanned() &&
        request.auth.uid == request.resource.data.from &&
        request.resource.data.to != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        !(request.auth.uid in get(/databases/$(database)/documents/users/$(request.resource.data.to)).data.get('blockedUsers', []));
      allow update: if isSignedIn() && request.auth.uid == resource.data.to &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt']) &&
        (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined');
      allow delete: if isSignedIn() &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // ======================== parental controls ========================
    // One-time pairing codes: created only by the child's own account, readable
    // while they exist, and short-lived. Being readable is what lets a guardian
    // claim one; a wrong guess is a random 8-character code that expires.
    match /parentalCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isNotBanned() &&
        request.auth.uid == request.resource.data.childUid &&
        request.resource.data.get('childUid', '') is string &&
        request.resource.data.get('expiresAt', 0) is int &&
        request.resource.data.get('expiresAt', 0) > request.time.toMillis();
      allow update: if false;
      allow delete: if isSignedIn();
    }

    // The guardian link is keyed by the guardian's uid. Creating it requires a
    // live code that belongs to the child being linked, and an account with no
    // guardian yet. This is the only way to become someone's guardian.
    match /parentalLinks/{parentUid} {
      // The guardian's own (possibly missing) document stays readable so the
      // Settings listener can report "no link" instead of a permission error.
      allow read: if isSignedIn() &&
        (parentUid == request.auth.uid || (resource != null && resource.data.childUid == request.auth.uid));
      allow create: if isNotBanned() &&
        parentUid == request.auth.uid &&
        request.resource.data.parentUid == request.auth.uid &&
        request.resource.data.childUid is string &&
        request.resource.data.childUid != request.auth.uid &&
        request.resource.data.code is string &&
        exists(/databases/$(database)/documents/parentalCodes/$(request.resource.data.code)) &&
        get(/databases/$(database)/documents/parentalCodes/$(request.resource.data.code)).data.childUid == request.resource.data.childUid &&
        request.time.toMillis() < get(/databases/$(database)/documents/parentalCodes/$(request.resource.data.code)).data.expiresAt &&
        !exists(/databases/$(database)/documents/parentalControls/$(request.resource.data.childUid));
      allow update: if false;
      // Only the guardian can end the arrangement. A blocked child cannot
      // unlink itself to get around the blocks.
      allow delete: if isSignedIn() && resource.data.parentUid == request.auth.uid;
    }

    // What a guardian can actually change on the child's account. The child may
    // read it, but never write or remove it.
    match /parentalControls/{childUid} {
      allow read: if isSignedIn() &&
        (request.auth.uid == childUid || resource.data.parentUid == request.auth.uid);
      allow create: if isNotBanned() &&
        request.resource.data.childUid == childUid &&
        request.resource.data.parentUid == request.auth.uid &&
        exists(/databases/$(database)/documents/parentalLinks/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/parentalLinks/$(request.auth.uid)).data.childUid == childUid &&
        request.resource.data.get('blockedCommunities', []) is list &&
        request.resource.data.get('blockCommunityCreation', false) is bool;
      allow update: if isSignedIn() &&
        resource.data.parentUid == request.auth.uid &&
        request.resource.data.parentUid == resource.data.parentUid &&
        request.resource.data.childUid == childUid &&
        request.resource.data.get('blockedCommunities', []) is list &&
        request.resource.data.get('blockCommunityCreation', false) is bool;
      allow delete: if isSignedIn() && resource.data.parentUid == request.auth.uid;
    }

    // ============================= app metadata =============================
    // Readable by any signed-in user (version check); never written by clients.
    match /app/metadata {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
