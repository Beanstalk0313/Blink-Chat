{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blink Chat",
  "version": "0.1.0",
  "identifier": "com.blink.chat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Blink Chat", "width": 1280, "height": 800, "minWidth": 360, "minHeight": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../public/favicon.svg"]
  }
}
